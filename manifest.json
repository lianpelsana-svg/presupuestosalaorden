{
  "manifest_version": 3,
  "name": "Comprador Inteligente AR",
  "version": "1.0",
  "description": "Filtra productos ocultando los que superan tu presupuesto. Funciona en MercadoLibre, Coto, Frávega y más.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configurar Presupuesto"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
